# Use a MongoDB Atlas connection string, or your existing replica-set URI.
MONGODB_URI=mongodb+srv://DB_USER:DB_PASSWORD@YOUR_CLUSTER/group41
SESSION_SECRET=replace-with-a-random-secret-of-at-least-32-characters
ADMIN_USERNAME=admin41
ADMIN_PASSWORD=replace-with-your-own-password-of-at-least-12-characters
PORT=8099
HOST=127.0.0.1
NODE_ENV=development
# Local course API demo: false. For an Internet-facing server: true.
API_AUTH_REQUIRED=false
# true only when behind one trusted HTTPS reverse proxy.
TRUST_PROXY=false
