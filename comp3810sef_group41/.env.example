# Copy this file to .env, generate a session secret and choose your own password.
SESSION_SECRET=replace-with-a-random-secret-of-at-least-32-characters
ADMIN_USERNAME=admin41
ADMIN_PASSWORD=replace-with-your-own-password-of-at-least-12-characters
PORT=8099
# Course curl demonstration; all web management pages still require login.
API_AUTH_REQUIRED=false
# MongoDB starts locally on 127.0.0.1:27041. No cloud URI is needed.
