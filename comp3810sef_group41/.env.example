# Copy this file to .env and fill in the required values.
SESSION_SECRET=replace-with-a-random-secret-of-at-least-32-characters
ADMIN_USERNAME=admin41
# At least 12 characters. Used when the administrator account is first created.
ADMIN_PASSWORD=replace-with-your-own-password-of-at-least-12-characters
PORT=8099
# Set to true to require a signed-in session for API requests.
API_AUTH_REQUIRED=false
# MongoDB is started locally on 127.0.0.1:27041; no external URI is required.
