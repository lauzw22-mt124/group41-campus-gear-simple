<%- include('../partials/header') %>
<div class="heading">
  <h1><%= title %></h1>
  <a href="/equipment">Back to equipment</a>
</div>
<form class="panel editor" method="post" action="<%= editing ? '/equipment/' + item._id + '/edit' : '/equipment' %>">
  <% if (error) { %><p class="alert" role="alert"><%= error %></p><% } %>
  <input type="hidden" name="_csrf" value="<%= csrf %>">
  <label>Asset code
    <input name="assetCode" value="<%= item.assetCode || '' %>" required maxlength="32" pattern="[A-Za-z0-9-]+" placeholder="e.g. PROJ-002">
  </label>
  <label>Equipment name
    <input name="name" value="<%= item.name || '' %>" required maxlength="120">
  </label>
  <label>Category
    <select name="category" required>
      <% for (const category of ['projector', 'microphone', 'tripod']) { %>
        <option value="<%= category %>" <%= item.category === category ? 'selected' : '' %>><%= labels[category] %></option>
      <% } %>
    </select>
  </label>
  <label>Location
    <input name="location" value="<%= item.location || '' %>" required maxlength="120">
  </label>
  <label>Notes (optional)
    <textarea name="description" maxlength="1000" rows="3"><%= item.description || '' %></textarea>
  </label>
  <p class="muted">Use check-out, return and maintenance actions to change the equipment status.</p>
  <div class="actions">
    <button class="primary">Save equipment</button>
    <a href="/equipment">Cancel</a>
  </div>
</form>
<%- include('../partials/footer') %>
